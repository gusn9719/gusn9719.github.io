---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const detailLink = project.links.find((link) => link.kind === "detail");
const isHomeEntry = Boolean(project.homeEntry && detailLink);
---

<article class:list={["project-row", { "project-row--entry": isHomeEntry }]} aria-labelledby={`${project.slug}-title`}>
  <div class="project-row__index" aria-hidden="true">{project.order}</div>
  <div class="project-row__body">
    <div class="project-row__heading">
      <div>
        <p class="eyebrow">{project.type}</p>
        <h3 id={`${project.slug}-title`}>
          {isHomeEntry ? (
            <a class="project-row__title-link" href={detailLink!.href}>{project.title}</a>
          ) : project.title}
        </h3>
      </div>
      <p class="project-row__context">{project.context}</p>
    </div>

    {isHomeEntry && <p class="project-row__lede">{project.homeEntry!.summary}</p>}

    <figure class:list={["project-preview", { "project-preview--portrait": !isHomeEntry && project.preview.items.some((item) => item.presentation === "portrait"), "project-preview--flow": isHomeEntry }] }>
      {isHomeEntry ? (
        <a class="project-preview__link" href={detailLink!.href} aria-label={`${project.title} Case Study 보기`}>
          <div class:list={["project-preview__media", { "project-preview__media--split": project.preview.items.length > 1 }] }>
            {project.preview.items.map((item) => (
              <div class:list={["project-preview__item", `project-preview__item--${item.fit ?? "cover"}`, item.presentation && `project-preview__item--${item.presentation}`]}>
                <span>{item.label}</span>
                <img
                  src={item.src}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
          </div>
        </a>
      ) : (
        <div class:list={["project-preview__media", { "project-preview__media--split": project.preview.items.length > 1 }] }>
          {project.preview.items.map((item) => (
            <div class:list={["project-preview__item", `project-preview__item--${item.fit ?? "cover"}`, item.presentation && `project-preview__item--${item.presentation}`]}>
              <span>{item.label}</span>
              <img
                src={item.src}
                alt={item.alt}
                width={item.width}
                height={item.height}
                loading="lazy"
                decoding="async"
              />
            </div>
          ))}
        </div>
      )}
      <figcaption>{project.preview.caption}</figcaption>
    </figure>

    {isHomeEntry ? (
      <div class="project-row__contribution">
        <p class="eyebrow">My contribution</p>
        <p>{project.homeEntry!.contribution}</p>
      </div>
    ) : (
      <div class="project-row__summary">
        <div>
          <p class="summary-label">Problem</p>
          <p>{project.problem}</p>
        </div>
        <div>
          <p class="summary-label">Built</p>
          <p>{project.result}</p>
        </div>
        <div>
          <p class="summary-label">Contribution</p>
          <p>{project.contribution}</p>
        </div>
      </div>
    )}

    <div class="project-row__footer">
      <ul class="inline-list">
        {project.stack.map((item) => <li>{item}</li>)}
      </ul>
      <div class="project-links">
        {project.links.map((link) => (
          <a
            class:list={[
              isHomeEntry && link.kind === "detail" ? "button button--accent" : "text-link",
              { "text-link--primary": !isHomeEntry && link.kind === "detail" },
            ]}
            href={link.href}
            target={link.kind === "detail" ? undefined : "_blank"}
            rel={link.kind === "detail" ? undefined : "noopener noreferrer"}
          >
            {isHomeEntry && link.kind === "detail" ? project.homeEntry!.ctaLabel : link.label} <span aria-hidden="true">{link.kind === "detail" ? "→" : "↗"}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</article>
