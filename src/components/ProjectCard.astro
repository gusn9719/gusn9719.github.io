---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const detailLink = project.links.find((link) => link.kind === "detail");
const isHomeEntry = Boolean(project.homeEntry && detailLink);
const homeEvidence = project.homeEntry?.evidence;
const hasMultiplePreviews = isHomeEntry && !homeEvidence && project.preview.items.length > 1;
const homeCaption = homeEvidence?.caption ?? project.preview.caption;
---

<article class:list={["project-row", { "project-row--entry": isHomeEntry }]} aria-labelledby={`${project.slug}-title`}>
  <div class="project-row__index" aria-hidden="true">{project.order}</div>
  <div class="project-row__body">
    <div class="project-row__heading">
      <div>
        <p class="eyebrow">{project.type}</p>
        <h3 id={`${project.slug}-title`}>
          {isHomeEntry ? (
            <a class="project-row__title-link" href={detailLink!.href}>{project.title}</a>
          ) : project.title}
        </h3>
      </div>
      <p class="project-row__context">{project.context}</p>
    </div>

    {isHomeEntry && <p class="project-row__lede">{project.homeEntry!.summary}</p>}

    <figure class:list={["project-preview", {
      "project-preview--portrait": !isHomeEntry && project.preview.items.some((item) => item.presentation === "portrait"),
      "project-preview--entry": isHomeEntry,
      "project-preview--flow": isHomeEntry && project.homeEntry!.layout === "phone-flow",
      "project-preview--evolution": isHomeEntry && project.homeEntry!.layout === "evolution",
      "project-preview--record": isHomeEntry && project.homeEntry!.layout === "record",
    }] }>
      {isHomeEntry && homeEvidence ? (
        <a
          class="project-evidence-record__link"
          href={detailLink!.href}
          aria-label={`${project.title} Case Study 보기 — ${homeEvidence.id} 평가 기록`}
        >
          <div class="project-evidence-record">
            <div class="project-evidence-record__header">
              <p>{homeEvidence.label}</p>
              <strong>{homeEvidence.id}</strong>
            </div>
            <div class="project-evidence-record__question">
              <p class="summary-label">Question</p>
              <p lang="en">{homeEvidence.question}</p>
            </div>
            <div class="project-evidence-record__comparison">
              <div>
                <p class="summary-label">Retrieved evidence</p>
                <p>{homeEvidence.retrieved}</p>
              </div>
              <div>
                <p class="summary-label">Expected</p>
                <p lang="en">{homeEvidence.expected}</p>
              </div>
              <div>
                <p class="summary-label">Generated</p>
                <p lang="en">{homeEvidence.generated}</p>
              </div>
            </div>
            <div class="project-evidence-record__result">
              <div>{homeEvidence.outcomes.map((outcome) => <span>{outcome}</span>)}</div>
              <p>{homeEvidence.boundary}</p>
            </div>
          </div>
        </a>
      ) : isHomeEntry ? (
        <div
          class:list={["project-preview__media", { "project-preview__media--split": project.preview.items.length > 1 }]}
          role="group"
          aria-label={`${project.title} 화면 미리보기`}
          aria-describedby={hasMultiplePreviews ? `${project.slug}-swipe-hint` : undefined}
        >
          {project.preview.items.map((item) => (
            <a
              class:list={["project-preview__link", "project-preview__item", `project-preview__item--${item.fit ?? "cover"}`, item.presentation && `project-preview__item--${item.presentation}`]}
              href={detailLink!.href}
              aria-label={`${item.label} — ${project.title} Case Study 보기`}
            >
              <span>{item.label}</span>
              <img
                src={item.src}
                alt={item.alt}
                width={item.width}
                height={item.height}
                loading="lazy"
                decoding="async"
              />
            </a>
          ))}
        </div>
      ) : (
        <div class:list={["project-preview__media", { "project-preview__media--split": project.preview.items.length > 1 }] }>
          {project.preview.items.map((item) => (
            <div class:list={["project-preview__item", `project-preview__item--${item.fit ?? "cover"}`, item.presentation && `project-preview__item--${item.presentation}`]}>
              <span>{item.label}</span>
              <img
                src={item.src}
                alt={item.alt}
                width={item.width}
                height={item.height}
                loading="lazy"
                decoding="async"
              />
            </div>
          ))}
        </div>
      )}
      {hasMultiplePreviews && (
        <p id={`${project.slug}-swipe-hint`} class="project-preview__swipe-hint">
          <span aria-hidden="true">←</span>
          <span>좌우로 밀거나 Tab 키로 다음 화면 보기</span>
          <span aria-hidden="true">→</span>
        </p>
      )}
      <figcaption>{homeCaption}</figcaption>
    </figure>

    {isHomeEntry ? (
      <div class="project-row__contribution">
        <p class="eyebrow">My contribution</p>
        <p>{project.homeEntry!.contribution}</p>
      </div>
    ) : (
      <div class="project-row__summary">
        <div>
          <p class="summary-label">Problem</p>
          <p>{project.problem}</p>
        </div>
        <div>
          <p class="summary-label">Built</p>
          <p>{project.result}</p>
        </div>
        <div>
          <p class="summary-label">Contribution</p>
          <p>{project.contribution}</p>
        </div>
      </div>
    )}

    <div class="project-row__footer">
      <ul class="inline-list">
        {project.stack.map((item) => <li>{item}</li>)}
      </ul>
      <div class="project-links">
        {project.links.map((link) => (
          <a
            class:list={[
              isHomeEntry && link.kind === "detail" ? "button button--accent" : "text-link",
              { "text-link--primary": !isHomeEntry && link.kind === "detail" },
            ]}
            href={link.href}
            target={link.kind === "detail" ? undefined : "_blank"}
            rel={link.kind === "detail" ? undefined : "noopener noreferrer"}
          >
            {isHomeEntry && link.kind === "detail" ? project.homeEntry!.ctaLabel : link.label} <span aria-hidden="true">{link.kind === "detail" ? "→" : "↗"}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</article>
