---
interface Props {
  number: string;
  title: string;
  description?: string;
  id: string;
}

const { number, title, description, id } = Astro.props;
---

<div class="section-heading">
  <p class="section-heading__number" aria-hidden="true">{number}</p>
  <div>
    <h2 id={id}>{title}</h2>
    {description && <p>{description}</p>}
  </div>
</div>
