---
import BaseLayout from "./BaseLayout.astro";
import { projects, type Project } from "../data/projects";

interface Props {
  project: Project;
  description: string;
  sections: Array<{ id: string; label: string }>;
}

const { project, description, sections } = Astro.props;
const projectIndex = projects.findIndex((candidate) => candidate.slug === project.slug);
const previousProject = projects[(projectIndex - 1 + projects.length) % projects.length];
const nextProject = projects[(projectIndex + 1) % projects.length];
---

<BaseLayout title={`${project.title} | 임현우 Portfolio`} description={description} compactHeader>
  <article class="case-study">
    <header class="project-hero">
      <a class="back-link" href="/#projects"><span aria-hidden="true">←</span> Home으로 돌아가기</a>
      <div class="project-hero__heading">
        <div>
          <p class="eyebrow">{project.order} · {project.type}</p>
          <h1>{project.title}</h1>
        </div>
        <p class="project-hero__context">{project.context}</p>
      </div>
      <p class="project-hero__lede">{project.problem}</p>

      <dl class="project-meta">
        <div>
          <dt>Type</dt>
          <dd>{project.context}</dd>
        </div>
        <div>
          <dt>My role</dt>
          <dd>{project.role}</dd>
        </div>
        <div>
          <dt>Core tools</dt>
          <dd>{project.stack.join(" · ")}</dd>
        </div>
      </dl>

      <div class="project-actions">
        {project.links.filter((link) => link.kind !== "detail").map((link) => (
          <a class="button" href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label} <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </header>

    <nav class="project-section-nav" aria-label="Case Study 목차">
      <div class="project-section-nav__inner">
        <span>On this page</span>
        <ol>
          {sections.map((section) => (
            <li><a href={`#${section.id}`}>{section.label}</a></li>
          ))}
        </ol>
      </div>
    </nav>

    <slot name="lead-visual" />

    <div class="case-content">
      <slot />
    </div>

    <nav class="project-switcher" aria-label="다른 Case Study">
      <a href={`/projects/${previousProject.slug}/`}>
        <span class="project-switcher__direction">Previous</span>
        <strong><span aria-hidden="true">←</span> {previousProject.title}</strong>
      </a>
      <a href={`/projects/${nextProject.slug}/`}>
        <span class="project-switcher__direction">Next</span>
        <strong>{nextProject.title} <span aria-hidden="true">→</span></strong>
      </a>
    </nav>
  </article>
</BaseLayout>
