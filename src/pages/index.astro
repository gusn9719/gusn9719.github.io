---
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
import {
  achievements,
  certifications,
  education,
  profile,
  skillGroups,
} from "../data/profile";
---

<BaseLayout
  title="임현우 | Developer Portfolio"
  description="문제를 확인 가능한 근거로 좁히고, 데이터와 기능을 실제 서비스 흐름으로 연결해 온 임현우의 개발 포트폴리오입니다."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__meta">
      <p>Developer Portfolio</p>
      <p>Seongnam, Korea · 2026</p>
    </div>
    <div class="hero__content">
      <div>
        <p class="eyebrow">Hyunwoo Lim</p>
        <h1 id="hero-title">임현우</h1>
      </div>
      <div class="hero__statement">
        <p>{profile.hero}</p>
        <div class="hero__actions">
          <a class="button button--accent" href="#projects">대표 프로젝트 보기</a>
          <a class="button" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub에서 코드 보기 <span aria-hidden="true">↗</span></a>
        </div>
        <p class="hero__education">{profile.school} · 누적 {profile.grade}</p>
      </div>
    </div>
  </section>

  <section id="projects" class="page-section projects" aria-labelledby="projects-title">
    <div class="content-width">
      <SectionHeading
        number="01"
        id="projects-title"
        title="Featured Projects"
        description="완성된 화면보다 문제 정의, 개인 기여, 검증 과정이 먼저 보이도록 정리했습니다."
      />
      <div class="project-list">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section id="about" class="page-section" aria-labelledby="about-title">
    <div class="content-width">
      <SectionHeading number="02" id="about-title" title="About" />
      <div class="about-grid">
        <p class="about-grid__lead">확인한 사실을 기준으로 문제의 범위를 좁히고, 함께 일할 때는 판단 근거와 남은 한계를 정확히 공유합니다.</p>
        <div class="prose">
          {profile.about.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="skills-title">
    <div class="content-width">
      <SectionHeading
        number="03"
        id="skills-title"
        title="Skills"
        description="대표 프로젝트와 교육에서 실제로 사용한 범위를 역할별로 정리했습니다."
      />
      <div class="skills-list">
        {skillGroups.map((group) => (
          <div class="skill-group">
            <h3>{group.title}</h3>
            <p>{group.items.join(" · ")}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="education" class="page-section" aria-labelledby="education-title">
    <div class="content-width">
      <SectionHeading number="04" id="education-title" title="Education · Achievements" />
      <div class="background-grid">
        <div>
          <h3 class="subsection-title">Education · Activity</h3>
          <div class="timeline">
            {education.map((item) => (
              <article class="timeline-item">
                <p class="timeline-item__period">{item.period}</p>
                <div>
                  <h4>{item.title}</h4>
                  <p>{item.detail}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
        <div class="background-grid__side">
          <div>
            <h3 class="subsection-title">Certifications</h3>
            <div class="compact-list">
              {certifications.map((item) => (
                <article>
                  <p>{item.period}</p>
                  <div><h4>{item.title}</h4><span>{item.detail}</span></div>
                </article>
              ))}
            </div>
          </div>
          <div>
            <h3 class="subsection-title">Achievements</h3>
            <div class="compact-list">
              {achievements.map((item) => (
                <article>
                  <p>{item.year}</p>
                  <div><h4>{item.title}</h4><span>{item.organization}</span></div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="contact-section" aria-labelledby="contact-title">
    <div class="content-width contact-section__inner">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 id="contact-title">함께 확인하고<br />해결할 일을 기다립니다.</h2>
      </div>
      <div class="contact-links">
        <a href={`mailto:${profile.email}`}><span>Email</span><strong>{profile.email}</strong></a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer"><span>GitHub</span><strong>github.com/gusn9719</strong></a>
      </div>
    </div>
  </section>
</BaseLayout>
